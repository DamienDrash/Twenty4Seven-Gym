# ── Beispiel-Konfiguration (NUR Platzhalter — KEINE echten Secrets committen!) ──
# Kopieren nach .env und mit echten Werten füllen. .env ist ge-gitignored.
# Abgeglichen gegen src/nuki_integration/config.py am 06.08.2026.

APP_ENV=production
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Berlin
APP_PUBLIC_BASE_URL=https://services.getimpulse.de/opengym
# Bind-Adresse/Port des FastAPI-Prozesses im Container
HOST=0.0.0.0
PORT=8080

POSTGRES_DB=studio_access
POSTGRES_USER=studio_access
POSTGRES_PASSWORD=change-me
POSTGRES_DATA_PATH=./data/postgres
WEB_BIND_HOST=0.0.0.0
WEB_PORT=8080

DATABASE_URL=postgresql://studio_access:change-me@db-service:5432/studio_access

# ── Magicline ────────────────────────────────────────────────────────────
MAGICLINE_BASE_URL=https://your-tenant.api.magicline.com
MAGICLINE_API_KEY=
MAGICLINE_WEBHOOK_API_KEY=
MAGICLINE_STUDIO_ID=0
MAGICLINE_STUDIO_NAME=GETIMPULSE
MAGICLINE_RELEVANT_APPOINTMENT_TITLE=Freies Training
# Worker-Takt in Minuten: Sync UND Zeitfenster-Zyklus laufen in einem Tick.
MAGICLINE_SYNC_INTERVAL_MINUTES=5
MAGICLINE_ENTITLEMENT_RATE_NAME=XXLARGE
MAGICLINE_ENTITLEMENT_PRODUCT_NAME=Freies Training

# ── Nuki ─────────────────────────────────────────────────────────────────
NUKI_BASE_URL=https://api.nuki.io
NUKI_TIMEOUT_SECONDS=15
NUKI_API_TOKEN=
NUKI_CLIENT_ID=
NUKI_CLIENT_SECRET=
NUKI_ACCESS_TOKEN=
NUKI_REFRESH_TOKEN=
NUKI_SMARTLOCK_ID=
# true = keine schreibenden Nuki-Calls (Trockenlauf). Produktion: false.
NUKI_DRY_RUN=true

# ── Nuki: Notfall-Flags (siehe docs/BETRIEB.md, Abschnitt 4) ─────────────
# Setzen/Zurücksetzen NUR mit Freigabe von Damien. Wirkt erst nach Rebuild/Recreate.
#
# NUKI_REQUIRE_DEVICE_CONFIRMATION (Default true = fail-closed):
#   Stellt einen Code nur zu, wenn das Gerät ihn bestätigt hat. Ein Code, der nur in
#   der Cloud steht, aber nie am Keypad ankam, wird NICHT zugestellt (Lockout-Schutz).
#   false = altes Verhalten „zustellen, sobald in der Cloud vorhanden".
NUKI_REQUIRE_DEVICE_CONFIRMATION=true
#
# NUKI_ROTATION_PAUSED (Default false):
#   true friert das Schloss ein — rotate_daily macht keinerlei Lock-Änderungen, die
#   101 Codes auf dem Keypad bleiben unverändert gültig, die Zustellung fällt auf die
#   zuletzt rotierten Pins zurück. Für Studio-Internet-/Router-Ausfälle. Hat Vorrang
#   vor force. Als Dauerzustand ein Sicherheitsrisiko (statische Türcodes).
NUKI_ROTATION_PAUSED=false
#
# Ab welchem Alter der neuesten Gerätebestätigung ein echter Cloud↔Schloss-Freeze
# angenommen wird. Beeinflusst nur den Alarmtext, nicht das Zustell-Gate.
NUKI_FREEZE_THRESHOLD_HOURS=3

# ── Nuki-Wächter (Webhook + Worker-Fallback) ─────────────────────────────
# Shared Secret für den Webhook-Wächter. Leer = der Wächter handelt nicht (fail closed).
NUKI_WEBHOOK_SECRET=
# Mindestabstand zwischen zwei Reconciles (Rate-Limit-Schutz), Sekunden.
NUKI_GUARDIAN_COOLDOWN_SECONDS=60
# Periodischer Reconcile auch ohne eingehenden Webhook, Sekunden.
NUKI_GUARDIAN_FALLBACK_INTERVAL_SECONDS=900

# ── Auth / Admin ─────────────────────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me
# JWT_SECRET: langer Zufallsstring, z.B. openssl rand -hex 32
JWT_SECRET=change-me

# ── Zustellung: E-Mail ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=

# ── Zustellung: Telegram ─────────────────────────────────────────────────
# In Produktion kommen Bot-Token und Chat-ID aus der gemounteten Credentials-Datei
# /opt/getimpulse/.credentials/opengym_telegram.env (mode 600, read-only), nicht hier.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Forum-Topic innerhalb der Gruppe (leer = kein Topic).
TELEGRAM_MESSAGE_THREAD_ID=

# ── Alarme ───────────────────────────────────────────────────────────────
# Operative Alarme (Wächter etc.) → E-Mail-Empfänger. Leer = Fallback SMTP_FROM_EMAIL.
ALERT_EMAIL=
# Optionaler ntfy-Push. Inaktiv, solange nicht beide Werte gesetzt sind.
NTFY_URL=
NTFY_TOPIC=
# Externer Dead-Man's-Switch (healthchecks.io). Meldet sich nach jedem
# erfolgreichen Worker-Zyklus. Leer = deaktiviert.
HEALTHCHECK_PING_URL=

# ── Medien ───────────────────────────────────────────────────────────────
MEDIA_STORAGE_PATH=./media/uploads
MEDIA_URL_BASE=/media

# ── HINWEIS: die folgenden Keys sind derzeit WIRKUNGSLOS ─────────────────
# Sie sind KEINE Felder von Settings (config.py) und werden nirgends aus der
# Umgebung gelesen (Settings nutzt extra="ignore", kein os.environ/os.getenv im
# Code). Der Wächter liest sie über getattr(settings, ...) und bekommt deshalb
# immer den hartkodierten Default — ein Wert in der .env ändert nichts.
# Belegt am 06.08.2026; zur Klärung an Damien gemeldet (PO-STATUS.md, Offene Fragen).
# Effektive Defaults aus timewindow/guardian.py:
#   GUARDIAN_ENABLED=true            (guardian.py:263)
#   GUARDIAN_AUTOFIX=true            (guardian.py:165, :275)
#   GUARDIAN_LOOKAHEAD_MINUTES=90    (guardian.py:279)
#   GUARDIAN_GRACE_MINUTES=20        (guardian.py:280)
#   NUKI_LOG_STALE_ALERT_HOURS=48    (guardian.py:243)
#   GUARDIAN_INTERVAL_SECONDS        — kein Leser im Code gefunden
