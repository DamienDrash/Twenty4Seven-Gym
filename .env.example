# ── Beispiel-Konfiguration (NUR Platzhalter — KEINE echten Secrets committen!) ──
# Kopieren nach .env und mit echten Werten füllen. .env ist ge-gitignored.

APP_ENV=production
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Berlin
APP_PUBLIC_BASE_URL=https://services.getimpulse.de/opengym

POSTGRES_DB=studio_access
POSTGRES_USER=studio_access
POSTGRES_PASSWORD=change-me
POSTGRES_DATA_PATH=./data/postgres
WEB_BIND_HOST=0.0.0.0
WEB_PORT=8080

DATABASE_URL=postgresql://studio_access:change-me@db-service:5432/studio_access

MAGICLINE_BASE_URL=https://your-tenant.api.magicline.com
MAGICLINE_API_KEY=
MAGICLINE_WEBHOOK_API_KEY=
MAGICLINE_STUDIO_ID=0
MAGICLINE_STUDIO_NAME=GETIMPULSE
MAGICLINE_RELEVANT_APPOINTMENT_TITLE=Freies Training

NUKI_BASE_URL=https://api.nuki.io
NUKI_API_TOKEN=
NUKI_SMARTLOCK_ID=
NUKI_DRY_RUN=true

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me
# JWT_SECRET: langer Zufallsstring, z.B. openssl rand -hex 32
JWT_SECRET=change-me

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operative Alarme (Wächter etc.) → E-Mail-Empfänger. Leer = Fallback SMTP_FROM_EMAIL.
ALERT_EMAIL=

# Wächter (Zugangscode-Verifikation am Schloss)
GUARDIAN_ENABLED=true
GUARDIAN_INTERVAL_SECONDS=60
GUARDIAN_LOOKAHEAD_MINUTES=90
GUARDIAN_GRACE_MINUTES=20
GUARDIAN_AUTOFIX=true
NUKI_LOG_STALE_ALERT_HOURS=48
